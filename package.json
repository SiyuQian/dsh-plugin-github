{
  "name": "dsh-plugin-github",
  "version": "0.7.0",
  "description": "GitHub in DeepSeek Harness: a sidebar tab with your open PRs and review requests, one-click Chinese walkthroughs and devpilot pr-review reviews in throwaway checkouts, a Create PR button, and PR titles on sessions.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "test": "node --test test.mjs",
    "sync-devpilot": "sh scripts/sync-devpilot.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiyuQian/dsh-plugin-github.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "github",
    "pull-request",
    "devpilot"
  ]
}
